# Copy this file to .env.local and fill in your own values.
# Both of these are PUBLIC values (they end up in the browser bundle) — that is fine and expected
# for a browser-only OAuth app. Security comes from the OAuth consent + the "Authorized JavaScript
# origins" allowlist on the client ID, not from hiding these strings.

# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web application)
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# The long id in your sheet URL:
# https://docs.google.com/spreadsheets/d/<THIS PART>/edit
VITE_SPREADSHEET_ID=your-spreadsheet-id-here

# A second, separate spreadsheet for the Expenses tab (one tab per month).
VITE_EXPENSES_SPREADSHEET_ID=your-expenses-spreadsheet-id-here
